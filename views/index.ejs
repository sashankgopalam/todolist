<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Todo List</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-4">
    <%- include('partials/header') %>

    <% if (query.error === 'empty') { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        Task field cannot be empty!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Add Task Form -->
    <form action="/add" method="POST" class="row gy-2 gx-3 align-items-center mb-4">
      <div class="col-sm-12 col-md-6">
        <input type="text" name="task" class="form-control" placeholder="Enter a task">
      </div>
      <div class="col-sm-6 col-md-3">
        <select name="priority" class="form-select">
          <option value="Low">Low</option>
          <option value="Medium">Medium</option>
          <option value="High">High</option>
        </select>
      </div>
      <div class="col-sm-6 col-md-3">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-plus-circle"></i> Add Task
        </button>
      </div>
    </form>

    <!-- Filter -->
    <form method="GET" action="/" class="mb-4">
      <div class="row">
        <div class="col-sm-12 col-md-4">
          <select name="priority" class="form-select" onchange="this.form.submit()">
            <option value="All" <%= query.priority === 'All' ? 'selected' : '' %>>All Priorities</option>
            <option value="Low" <%= query.priority === 'Low' ? 'selected' : '' %>>Low</option>
            <option value="Medium" <%= query.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
            <option value="High" <%= query.priority === 'High' ? 'selected' : '' %>>High</option>
          </select>
        </div>
      </div>
    </form>

    <!-- Todo List -->
    <% if (todos.length === 0) { %>
      <p class="text-muted">No tasks available.</p>
    <% } else { %>
      <ul class="list-group">
        <% todos.forEach((todo, index) => { %>
          <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-center mb-2">
            <form action="/edit/<%= index %>" method="POST" class="d-flex flex-column flex-md-row gap-2 w-100 mb-2 mb-md-0">
              <input type="text" name="task" class="form-control" value="<%= todo.task %>">
              <select name="priority" class="form-select w-auto">
                <option value="Low" <%= todo.priority === 'Low' ? 'selected' : '' %>>Low</option>
                <option value="Medium" <%= todo.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                <option value="High" <%= todo.priority === 'High' ? 'selected' : '' %>>High</option>
              </select>
              <button type="submit" class="btn btn-success">
                <i class="bi bi-pencil-square"></i>
              </button>
            </form>
            <form action="/delete/<%= index %>" method="POST">
              <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <%- include('partials/footer') %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
